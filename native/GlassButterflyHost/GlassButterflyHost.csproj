<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GlassButterfly</AssemblyName>
    <RootNamespace>GlassButterfly</RootNamespace>
    <!-- Icon shown on GlassButterfly.scr in Explorer and the Screen Saver panel. -->
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <!-- Screensavers must be DPI-correct across mixed-DPI multi-monitor setups. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Size trims (safe for this app; trimming itself is NOT safe for WinForms):
         drop ICU data — clock/date are formatted in JS, not .NET — and ship only
         English resource DLLs. Together these cut tens of MB from the self-
         contained build. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Evergreen WebView2 loader. If NuGet can't restore this exact version,
         bump to the latest 1.0.* — the APIs used here are long-stable. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window.glass bridge, embedded so it needs no C# string escaping. -->
    <EmbeddedResource Include="Bridge\bridge.js">
      <LogicalName>GlassButterfly.Bridge.bridge.js</LogicalName>
    </EmbeddedResource>
    <!-- The entire built renderer (dist/web), zipped by packaging\build-package.ps1
         and embedded so the .scr is a single self-contained file with no external
         asset folder. Absent during plain dev builds (dotnet run), where the host
         falls back to dist/web via RendererLocator. -->
    <EmbeddedResource Include="renderer.zip" Condition="Exists('renderer.zip')">
      <LogicalName>GlassButterfly.renderer.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
